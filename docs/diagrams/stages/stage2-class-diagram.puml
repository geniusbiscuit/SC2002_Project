@startuml
title Restaurant Rush - class diagram at stage-2 (VIP and Critic customers)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 45
skinparam defaultFontName Helvetica
skinparam class {
  BackgroundColor White
  BorderColor #333333
  ArrowColor #333333
  AttributeFontSize 11
}
skinparam package {
  BorderColor #888888
  FontStyle bold
}
hide empty members

package "boundary (Boundary classes)" {
  class ConsoleUI {
    - game : GameController
    - in : BufferedReader
    - out : PrintStream
    - echoInput : boolean
    + run()
    - playTurn()
    - showState()
    - waiterPhase()
    - chefPhase()
    - report(result : ActionResult) : boolean
    - readChoice(who : String, allowed : Set<Integer>) : int
    - readInt(prompt : String) : int
  }
  class Main {
    + {static} main(args : String[])
  }
  class InputEndedException <<RuntimeException>>
}

package "control (Control classes)" {
  class GameController {
    - config : GameConfig
    - restaurant : Restaurant
    - turn : int
    - nextCustomerId : int
    - phase : Phase
    + beginTurn() : List<String>
    + waiterSeat(customerId : int) : ActionResult
    + waiterTakeOrder(customerId : int) : ActionResult
    + waiterServe(customerId : int) : ActionResult
    + waiterWait() : ActionResult
    + chefPrepare(customerId : int) : ActionResult
    + chefWait() : ActionResult
    + endTurn() : TurnSummary
    + getResult() : GameResult
    + isGameOver() : boolean
  }
  enum "GameController.Phase" as Phase {
    AWAITING_TURN_START
    WAITER
    CHEF
    READY_TO_END
    FINISHED
  }
  class GameConfig <<final>> {
    - maxTurns : int
    - tableCount : int
    - requiredPaidCustomers : int
    - requiredRevenueCents : int
    - requiredAverageSatisfaction : int
    - menu : Menu
    - arrivals : List<ArrivalSlot>
    + {static} baseSetting() : GameConfig
    + {static} regularOnlySetting() : GameConfig
  }
  class "GameConfig.ArrivalSlot" as ArrivalSlot <<record>> {
    + turn : int
    + factory : IntFunction<Customer>
  }
  class ActionResult <<record>> {
    + success : boolean
    + message : String
  }
  class TurnSummary <<record>> {
    + turn : int
    + events : List<String>
  }
  class GameResult <<record>> {
    + outcome : Outcome
    + paidCount : int
    + revenueCents : int
    + satisfactionSum : int
    + servedCount : int
    + unhappyDepartures : int
    + turnsUsed : int
  }
  enum "GameResult.Outcome" as Outcome {
    VICTORY
    DEFEAT
  }
}

package "entity (Entity classes)" {
  class Restaurant {
    - menu : Menu
    - tables : List<Table>
    - customers : List<Customer>
    - waiter : Waiter
    - chef : Chef
    - cashier : Cashier
    + queuedCustomers() : List<Customer>
    + customersAwaitingOrder() : List<Customer>
    + servableOrders(turn : int) : List<Order>
    + preparableOrders() : List<Order>
    + startStaffTurn()
    + collectPayment(turn : int) : Optional<Payment>
    + finishEating(turn : int) : List<Customer>
    + applyWaitingLoss() : List<Customer>
    + getRevenueCents() : int
    + getPaidCount() : int
    + getAverageSatisfaction() : OptionalDouble
  }

  abstract class Customer {
    - id : int
    - satisfaction : int
    - state : CustomerState
    - table : Table
    - order : Order
    - servedTurn : int
    - readyToPayTurn : int
    - paidSatisfaction : int
    + {abstract} getTypeName() : String
    + {abstract} getWaitingLoss() : int
    + chooseItem(menu : Menu) : MenuItem
    + billFor(item : MenuItem) : int
    ~ sitAt(table : Table)
    ~ placeOrder(item : MenuItem, billCents : int) : Order
    ~ startEating(turn : int)
    ~ becomeReadyToPay(turn : int)
    ~ completePayment()
    ~ waitOneTurn()
    ~ leaveUnhappy()
  }
  class RegularCustomer {
    + getTypeName() : String
    + getWaitingLoss() : int
  }
  class VIPCustomer {
    + getTypeName() : String
    + getWaitingLoss() : int
    + billFor(item : MenuItem) : int
  }
  class CriticCustomer {
    + getTypeName() : String
    + getWaitingLoss() : int
    + chooseItem(menu : Menu) : MenuItem
  }
  enum CustomerState {
    WAITING_FOR_TABLE
    SEATED
    AWAITING_FOOD
    EATING
    READY_TO_PAY
    PAID
    ABANDONED
  }

  class Table {
    - number : int
    - occupant : Customer
    + isFree() : boolean
    ~ occupy(customer : Customer)
    ~ release()
  }

  class Order {
    - customer : Customer
    - item : MenuItem
    - billCents : int
    - remainingUnits : int
    - status : OrderStatus
    - readyTurn : int
    + isPreparable() : boolean
    + isServableOn(turn : int) : boolean
    ~ prepareOneUnit(turn : int)
    ~ markServed()
    ~ markPaid()
    ~ cancel()
  }
  enum OrderStatus {
    PLACED
    IN_PROGRESS
    READY
    SERVED
    PAID
    CANCELLED
  }

  class Menu {
    - items : List<MenuItem>
    + {static} classic() : Menu
    + defaultChoiceFor(customerId : int) : MenuItem
    + mostExpensive() : MenuItem
  }
  class MenuItem {
    - name : String
    - priceCents : int
    - prepUnits : int
    + getName() : String
    + getPriceCents() : int
    + getPrepUnits() : int
  }

  abstract class Staff {
    - role : String
    - actedThisTurn : boolean
    + startTurn()
    + rest()
    + hasActed() : boolean
    # ensureAvailable()
    # markActed()
  }
  class Waiter {
    + seat(customer : Customer, tables : Collection<Table>) : Table
    + takeOrder(customer : Customer, menu : Menu) : Order
    + serve(customer : Customer, turn : int) : Order
  }
  class Chef {
    + prepare(customer : Customer, turn : int) : Order
  }
  class Cashier {
    + collectPayment(customers : Collection<Customer>, turn : int) : Optional<Payment>
  }
  class Payment <<record>> {
    + customer : Customer
    + amountCents : int
    + tableNumber : int
    + satisfaction : int
  }
  class InvalidActionException <<RuntimeException>>
}

package "util" {
  class Money <<final>> {
    + {static} format(cents : int) : String
    + {static} percentOf(cents : int, percent : int) : int
  }
}

' ---------------- inheritance
Customer <|-- RegularCustomer
Customer <|-- VIPCustomer
Customer <|-- CriticCustomer
Staff <|-- Waiter
Staff <|-- Chef
Staff <|-- Cashier

' ---------------- boundary / control
Main ..> ConsoleUI : creates
Main ..> GameConfig : chooses setting
ConsoleUI --> "1" GameController : drives
GameController *-- "1" Restaurant
GameController --> "1" GameConfig
GameController --> "1" Phase
GameController ..> ActionResult : returns
GameController ..> TurnSummary : returns
GameController ..> GameResult : returns
GameResult --> "1" Outcome
GameConfig *-- "0..*" ArrivalSlot
GameConfig --> "1" Menu
ArrivalSlot ..> Customer : factory creates

' ---------------- entity relationships
Restaurant *-- "2..*" Table
Restaurant *-- "0..*" Customer : every arrival
Restaurant *-- "1" Waiter
Restaurant *-- "1" Chef
Restaurant *-- "1" Cashier
Restaurant o-- "1" Menu
Menu *-- "3..*" MenuItem
Customer "0..1" -- "0..1" Table : sits at
Customer "1" -- "0..1" Order : places
Order --> "1" MenuItem : of
Customer --> "1" CustomerState
Order --> "1" OrderStatus
Customer ..> Menu : chooseItem(menu)
Cashier ..> Payment : returns

' ---------------- layout hints
GameController -[hidden]down-> Restaurant
Staff -[hidden]down-> Waiter

' ---------------- annotations
note right of Customer
  <b>Encapsulation</b>
  All state is private. Only the staff and Restaurant
  (same package) can move a customer through its life
  cycle via package-private methods (~), and every
  transition validates the current state first.
end note

note bottom of CriticCustomer
  <b>Polymorphism</b>
  GameController and Restaurant only call the
  Customer API. getWaitingLoss() (8 / 5 / 12),
  billFor() (VIP -10%) and chooseItem() (Critic)
  are overridden, so no instanceof / type checks.
end note

note left of Restaurant
  <b>Composition</b>
  Restaurant owns its Tables, staff and every
  Customer (they do not exist without it).
end note

note bottom of Staff
  <b>Inheritance</b>
  "One task per turn" is implemented once in Staff
  (ensureAvailable / markActed) and shared by
  Waiter, Chef and Cashier.
end note
@enduml
